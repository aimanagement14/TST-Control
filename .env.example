# TST-Control — variables de entorno (plantilla)
#
# Copia este archivo a `.env` y rellena los valores reales:
#   cp .env.example .env
#
# `.env` está en .gitignore y NO debe commitearse.
# python-dotenv lo carga automáticamente al arrancar la app (load_dotenv en app.py).

# ---------------------------------------------------------------
# Obligatorio — Flask firma sesiones/CSRF con esta clave.
# Genera una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------
FLASK_SECRET_KEY=

# ---------------------------------------------------------------
# Logging — nivel del logger raíz (DEBUG, INFO, WARNING, ERROR).
# Por defecto INFO. Déjalo vacío para usar el valor por defecto.
# ---------------------------------------------------------------
TST_LOG_LEVEL=

# ---------------------------------------------------------------
# Servidor — controla cómo arranca `python app.py`.
# TST_SERVER=waitress  -> usa waitress (recomendado para prod local)
# TST_SERVER=(vacío)   -> usa el servidor de desarrollo de Flask
# TST_HOST, TST_PORT, TST_THREADS -> bindings del servidor.
# Déjalos vacíos para usar los valores por defecto.
# ---------------------------------------------------------------
TST_SERVER=
TST_HOST=
TST_PORT=
TST_THREADS=